Period Return = AVERAGEX(VALUES(fact[symbol]), VAR d0=CALCULATE(MIN(fact[date])) VAR d1=CALCULATE(MAX(fact[date])) VAR f=CALCULATE(MAX(fact[close]),fact[date]=d0) VAR l=CALCULATE(MAX(fact[close]),fact[date]=d1) RETURN DIVIDE(l,f)-1)
Indexed Price = VAR d0=MINX(ALLSELECTED(fact[date]),fact[date]) RETURN DIVIDE(MAX(fact[close]), CALCULATE(MAX(fact[close]),fact[date]=d0))*100
Avg Daily Return = AVERAGE(fact[ret])
Volatility 30D = AVERAGE(fact[vol30])
Annual Volatility = STDEV.S(fact[ret]) * SQRT(248)
Return per Risk = DIVIDE([Period Return],[Annual Volatility])
Max Drawdown = MIN(fact[drawdown])
Avg Daily Volume = AVERAGE(fact[volume])
Total Turnover = SUM(fact[turnover])
Turnover Share = DIVIDE([Total Turnover], CALCULATE([Total Turnover], ALLSELECTED(fact)))
Volume Spike Days = COUNTROWS(FILTER(fact, fact[vol_spike] > 2))
Stocks Up = COUNTROWS(FILTER(VALUES(fact[symbol]), [Period Return] > 0))
Stocks Down = COUNTROWS(FILTER(VALUES(fact[symbol]), [Period Return] < 0))
Best Stock = MAXX(TOPN(1, VALUES(fact[symbol]), [Period Return]), fact[symbol])
Worst Stock = MAXX(TOPN(1, VALUES(fact[symbol]), [Period Return], ASC), fact[symbol])
